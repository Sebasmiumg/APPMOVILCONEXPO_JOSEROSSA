# Copia este archivo a ".env" en la raíz del proyecto y completa los valores
# con los datos de tu proyecto de Supabase (Project Settings → API).
#
# Ambas variables son públicas a propósito: el prefijo EXPO_PUBLIC_ hace que
# Expo las incluya en el bundle del cliente. NUNCA coloques aquí una clave
# secreta (service_role) ni claves de proveedores de IA o búsqueda — esas
# deben vivir únicamente en Supabase Edge Functions (ver supabase/functions).
#
# Mientras estas variables no estén definidas, MiPresupuesto sigue funcionando
# por completo en modo local/demostración (sin nube), tal como en las Fases 1-4.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Token de cliente para los recursos APOD y NeoWs de NASA Open APIs.
# Solicítalo gratuitamente en https://api.nasa.gov/ y evita publicar tu .env.
# EXPO_PUBLIC_ implica que será visible en el bundle; para producción conviene
# ocultarlo detrás de una Edge Function y aplicar límites por usuario.
EXPO_PUBLIC_NASA_API_KEY=
