{
  "expo": {
    "name": "MiPresupuesto",
    "slug": "mipresupuesto",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mipresupuesto",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#10130F",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mipresupuesto.app"
    },
    "android": {
      "package": "com.mipresupuesto.app",
      "versionCode": 2,
      "allowBackup": false,
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"],
      "adaptiveIcon": {
        "backgroundColor": "#10130F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#10130F",
          "dark": {
            "backgroundColor": "#10130F"
          }
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "photosPermission": "MiPresupuesto necesita acceso a tus fotos para adjuntar comprobantes a tus movimientos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D6AB25"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "MiPresupuesto usa Face ID para proteger el acceso a tus finanzas."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
