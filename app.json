{
  "expo": {
    "name": "MiPresupuesto",
    "slug": "mipresupuesto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mipresupuesto",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#070A18",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070A18",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#070A18",
          "dark": {
            "backgroundColor": "#070A18"
          }
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "MiPresupuesto necesita acceso a tus fotos para adjuntar comprobantes a tus movimientos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7C4DFF"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "MiPresupuesto usa Face ID para proteger el acceso a tus finanzas."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
