    "braces": "file:vendor/security-patches/braces",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "node-forge": "file:vendor/security-patches/node-forge",
