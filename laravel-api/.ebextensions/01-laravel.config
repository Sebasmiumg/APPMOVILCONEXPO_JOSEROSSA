option_settings:
  aws:elasticbeanstalk:container:php:phpini:
    document_root: /public
    memory_limit: 256M
  aws:elasticbeanstalk:application:environment:
    APP_ENV: production
    # Fuera de /var/app/current a propósito: cada deploy reemplaza esa carpeta
    # por completo, así que una base de datos ahí adentro se perdía en cada
    # despliegue. /var/app/db vive en el disco de la instancia y sobrevive.
    DB_DATABASE: /var/app/db/database.sqlite
    SUPABASE_URL: "https://jjldzbycbpuzfmdaehsh.supabase.co"
    SUPABASE_PUBLISHABLE_KEY: "sb_publishable_JeBqH0wyF6IvVBmZut583g_qRgDfXPP"
