          "mode": "raw",
          "raw": "{\n  \"descripcion\": \"Compra de supermercado\",\n  \"monto\": 350.75,\n  \"tipo\": \"gasto\",\n  \"categoria\": \"Comida\",\n  \"cuenta\": \"Efectivo\",\n  \"fecha\": \"2026-08-20\"\n}"
