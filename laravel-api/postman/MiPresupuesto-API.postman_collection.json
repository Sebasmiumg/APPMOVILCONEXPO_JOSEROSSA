          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Devuelve el movimiento creado con id', () => pm.expect(body).to.have.property('id'));",
              "pm.test('Los campos coinciden con lo enviado', () => {",
              "  pm.expect(body.descripcion).to.eql('Compra de supermercado');",
              "  pm.expect(body.tipo).to.eql('gasto');",
              "});",
              "pm.collectionVariables.set('movimiento_id', body.id);"
            ]
          }
        }
      ]
